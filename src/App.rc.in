#include <windows.h>
#include <commctrl.h>
#include "Resource.h"

1 ICON "@PAPERSHADE_ICON@"

IDD_WARMTH DIALOGEX 0, 0, 270, 136
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PaperShade - Color temperature"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Color temperature (Kelvin)", -1, 12, 10, 240, 12
    CONTROL "", IDC_KELVIN_SLIDER, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 10, 27, 250, 24
    LTEXT "1000 K - very warm", -1, 12, 52, 105, 12
    LTEXT "6500 K - neutral / off", -1, 149, 52, 110, 12
    LTEXT "Kelvin value", -1, 12, 73, 55, 12
    EDITTEXT IDC_KELVIN_VALUE, 72, 71, 58, 15, ES_NUMBER | ES_RIGHT | WS_TABSTOP
    LTEXT "K", -1, 136, 73, 14, 12
    PUSHBUTTON "Neutral", IDC_KELVIN_NEUTRAL, 159, 71, 62, 15
    LTEXT "", IDC_KELVIN_ERROR, 12, 91, 248, 14
    DEFPUSHBUTTON "Apply", IDOK, 125, 112, 65, 16
    PUSHBUTTON "Cancel", IDCANCEL, 196, 112, 65, 16
END

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "PaperShade desktop filters\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "PaperShade\0"
            VALUE "OriginalFilename", "PaperShade.exe\0"
            VALUE "ProductName", "PaperShade\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
